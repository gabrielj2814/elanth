---
// Iconos de trazo único (1.75) dibujados para Elanth.
interface Props {
  name: 'arrow' | 'sync' | 'check' | 'clock' | 'store' | 'database' | 'channels' | 'team' | 'megaphone' | 'tag' | 'box' | 'printer' | 'whatsapp' | 'spark' | 'sprout' | 'building' | 'heart' | 'chat' | 'bag' | 'film' | 'camera' | 'layers' | 'calendar' | 'chart' | 'pen' | 'signal' | 'bolt' | 'target';
  class?: string;
  label?: string;
}
const { name, class: className = 'size-5', label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'sync' && (
    <>
      <path d="M20 8a8.5 8.5 0 0 0-15.3-1.6L3.5 8" />
      <path d="M3.5 3.5V8H8" />
      <path d="M4 16a8.5 8.5 0 0 0 15.3 1.6l1.2-1.6" />
      <path d="M20.5 20.5V16H16" />
    </>
  )}
  {name === 'check' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m8 12.3 2.7 2.7L16.2 9.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" stroke-dasharray="3 2.2" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'store' && (
    <>
      <path d="M4 9.5 5.5 4h13L20 9.5" />
      <path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0" />
      <path d="M5.5 12.5V20h13v-7.5M10 20v-4.5h4V20" />
    </>
  )}
  {name === 'database' && (
    <>
      <ellipse cx="12" cy="5.5" rx="7" ry="2.5" />
      <path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13" />
      <path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" />
    </>
  )}
  {name === 'channels' && (
    <>
      <circle cx="5" cy="12" r="2" />
      <circle cx="19" cy="5" r="2" />
      <circle cx="19" cy="12" r="2" />
      <circle cx="19" cy="19" r="2" />
      <path d="M7 12h10M7 11.2 17 5.8M7 12.8l10 5.4" />
    </>
  )}
  {name === 'team' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 20a5.5 5.5 0 0 1 11 0" />
      <path d="M15.5 5.3a3 3 0 0 1 0 5.4M17.5 14.3A5.5 5.5 0 0 1 20.5 20" />
    </>
  )}
  {name === 'megaphone' && (
    <>
      <path d="M4 10v4h3l8 4.5v-13L7 10H4Z" />
      <path d="M18.5 9a4 4 0 0 1 0 6M7 14l1.2 5.5h2.6L10 15" />
    </>
  )}
  {name === 'tag' && (
    <>
      <path d="M3.5 12.6V4.5a1 1 0 0 1 1-1h8.1l8 8a1.4 1.4 0 0 1 0 2l-7.1 7.1a1.4 1.4 0 0 1-2 0l-8-8Z" />
      <circle cx="8.5" cy="8.5" r="1.5" />
    </>
  )}
  {name === 'box' && (
    <>
      <path d="m12 3 8 4.2v9.6L12 21l-8-4.2V7.2L12 3Z" />
      <path d="m4 7.2 8 4.3 8-4.3M12 11.5V21" />
    </>
  )}
  {name === 'printer' && (
    <>
      <path d="M7 8V3.5h10V8" />
      <rect x="3.5" y="8" width="17" height="8.5" rx="1.5" />
      <path d="M7 14h10v6.5H7z" />
    </>
  )}
  {name === 'spark' && (
    <>
      <path d="M12 3.5c.6 3.9 2.6 5.9 6.5 6.5-3.9.6-5.9 2.6-6.5 6.5-.6-3.9-2.6-5.9-6.5-6.5 3.9-.6 5.9-2.6 6.5-6.5Z" />
      <path d="M18.5 15.5c.25 1.5 1 2.25 2.5 2.5-1.5.25-2.25 1-2.5 2.5-.25-1.5-1-2.25-2.5-2.5 1.5-.25 2.25-1 2.5-2.5Z" />
    </>
  )}
  {name === 'sprout' && (
    <>
      <path d="M12 21v-9" />
      <path d="M12 12c0-3.6-2.4-6-6.5-6 0 3.6 2.4 6 6.5 6Z" />
      <path d="M12 14.5c0-3.3 2.2-5.5 6.5-5.5 0 3.3-2.2 5.5-6.5 5.5Z" />
    </>
  )}
  {name === 'building' && (
    <>
      <path d="M4 20.5h16M6 20.5V4.5h8v16M14 9.5h4v11" />
      <path d="M9 8h2M9 11.5h2M9 15h2" />
    </>
  )}
  {name === 'heart' && <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20Z" />}
  {name === 'chat' && <path d="M4.5 18.5V6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8.5l-4 2Z" />}
  {name === 'bag' && (
    <>
      <path d="M5 8h14l-1 12.5H6L5 8Z" />
      <path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" />
    </>
  )}
  {name === 'film' && (
    <>
      <rect x="4" y="3.5" width="16" height="17" rx="2" />
      <path d="m10 9 5 3-5 3V9Z" />
    </>
  )}
  {name === 'camera' && (
    <>
      <path d="M4 8.5a1.5 1.5 0 0 1 1.5-1.5h2.3l1.5-2.5h5.4l1.5 2.5h2.3A1.5 1.5 0 0 1 20 8.5v10a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-10Z" />
      <circle cx="12" cy="13" r="3.5" />
    </>
  )}
  {name === 'layers' && (
    <>
      <path d="m12 4 8.5 4.5L12 13 3.5 8.5 12 4Z" />
      <path d="m3.5 12.5 8.5 4.5 8.5-4.5M3.5 16.5 12 21l8.5-4.5" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="4" y="5.5" width="16" height="15" rx="2" />
      <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" />
    </>
  )}
  {name === 'chart' && <path d="M4 20.5h16M7 17v-5M12 17V7M17 17v-8" />}
  {name === 'pen' && <path d="M15.5 4.5 19.5 8.5 9 19l-5 1 1-5L15.5 4.5Z" />}
  {name === 'signal' && (
    <>
      <circle cx="12" cy="13" r="1.5" />
      <path d="M8.5 9.5a5 5 0 0 0 0 7M15.5 9.5a5 5 0 0 1 0 7M5.5 6.5a9.2 9.2 0 0 0 0 13M18.5 6.5a9.2 9.2 0 0 1 0 13" />
    </>
  )}
  {name === 'bolt' && <path d="M13 3 5.5 13.5H12L11 21l7.5-10.5H12L13 3Z" />}
  {name === 'target' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="12" cy="12" r="0.8" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6l-3.9.9Z" />
      <path d="M9.2 9.1c.3 2.6 2.4 5 5.6 5.7l1-1.3-1.8-.9-.8.8a4.3 4.3 0 0 1-2.4-2.4l.8-.8-.9-1.8-1.5.7Z" />
    </>
  )}
</svg>
