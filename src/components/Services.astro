---
import Icon from './Icon.astro';
import Printer from './Printer.astro';
import RingNum from './RingNum.astro';
import LevelIllustration from './LevelIllustration.astro';

import { levels } from '../data/levels';
import { asset } from '../config';

// Acompañan cualquier nivel
const support = [
  {
    icon: 'megaphone',
    title: 'Marketing y tráfico digital',
    note: 'Acompañamiento',
    body: 'Atraemos a potenciales clientes a tu tienda con redes sociales, contenido y campañas publicitarias según el nicho de tu negocio.',
  },
  {
    icon: 'team',
    title: 'Gestión delegada',
    note: 'Acompañamiento',
    body: 'Tienda 100% automatizada y delegada: personal capacitado por Elanth la administra y tú te enfocas en recibir los pedidos.',
  },
  {
    icon: 'target',
    title: 'Posicionamiento SEO',
    note: 'Para buscadores y para IA',
    body: 'Optimizamos tu tienda para que aparezca en Google y en las respuestas de los asistentes de inteligencia artificial cuando tus clientes buscan lo que vendes.',
  },
] as const;

---
<section id="servicios" class="mesh-soft text-ink" data-services>
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-24 lg:px-12">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-navy lg:col-span-7">Tus ventas en línea, de principio a fin.</h2>
      <p class="max-w-[36rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-2">
        E-Commerce 360° es nuestra solución llave en mano: no solo creamos tu tienda, también podemos centralizar y
        automatizar todos tus canales de venta para que evolucione tu forma de vender sin aumentar significativamente tu
        carga operativa.
      </p>
    </div>

    <div class="mt-12 grid gap-10 sm:mt-16 xl:grid-cols-12 xl:gap-8">
      <!-- La comandera: los pedidos de todos los canales en un solo lugar -->
      <div class="xl:col-span-4">
        <div class="xl:sticky xl:top-24">
          <Printer />
        </div>
      </div>

      <!-- Niveles -->
      <div class="levels xl:col-span-8" data-levels>
        <div class="levels-head">
          <RingNum value="360" progress={1} size={52} dark />
          <span>
            <span class="block text-xl font-[800] tracking-[-0.01em] text-paper [font-stretch:116%] sm:text-2xl">Avanza por niveles</span>
            <span class="mt-0.5 block text-sm text-fog sm:text-[0.9375rem]">Contrata lo que tu negocio necesita hoy y sube de nivel cuando quieras.</span>
          </span>
        </div>

        <div class="levels-body mt-3">
          <div class="tabs" role="tablist" aria-label="Niveles de E-Commerce 360°" aria-orientation="vertical">
            {levels.map((l, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${l.id}`}
                class="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`nivel-${l.level}`}
                tabindex={i === 0 ? 0 : -1}
                data-tab={i}
              >
                <RingNum value={l.level} progress={l.level / levels.length} size={46} />
                <span class="min-w-0 text-left">
                  <span class="tag-label tab-label block">Nivel {l.level}</span>
                  <span class="mt-1 block text-[0.9875rem] leading-snug font-bold [font-stretch:106%]">{l.title}</span>
                </span>
              </button>
            ))}
          </div>

          <div class="panels">
            {levels.map((l, i) => (
              <article id={`nivel-${l.level}`} class:list={['panel card-soft', { active: i === 0 }]} role="tabpanel" aria-labelledby={`tab-${l.id}`} data-panel={i}>
                <span class="watermark" aria-hidden="true">{l.level}</span>
                <div class="flex items-center gap-3">
                  <span class="panel-ring"><RingNum value={l.level} progress={l.level / levels.length} size={40} /></span>
                  <span class="tag-label">Nivel {l.level}</span>
                </div>
                <h3 class="display mt-4 max-w-[30rem] text-[clamp(1.75rem,3.2vw,2.5rem)] text-navy">{l.title}</h3>
                <p class="mt-4 max-w-[36rem] text-[1.0625rem] leading-relaxed text-ink/85">{l.body}</p>
                <p class="mt-4 flex items-start gap-2 font-semibold text-blue-ink">
                  <Icon name="arrow" class="mt-[0.2em] size-4 shrink-0" />
                  {l.result}
                </p>
                <a href={asset(`servicios/${l.slug}/`)} class="level-more mt-5">
                  Ver más sobre este nivel
                  <Icon name="arrow" class="size-4" />
                </a>

                {/* Ilustración del nivel */}
                <LevelIllustration level={l.level} class="mt-7" />
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Acompañamiento -->
    <div class="mt-16 sm:mt-20">
      <div class="grid gap-3 lg:grid-cols-12 lg:items-end">
        <h3 class="text-[clamp(1.5rem,3vw,2.125rem)] leading-tight font-[820] tracking-[-0.02em] text-navy [font-stretch:116%] lg:col-span-7">Acompañamos tu proceso con</h3>
        <p class="text-muted lg:col-span-5">Disponibles en cualquier nivel.</p>
      </div>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {support.map((s) => (
          <li class="card-soft flex flex-col p-6 sm:p-7">
            <span class="hex"><Icon name={s.icon} class="size-5" /></span>
            <span class="tag-label mt-5">{s.note}</span>
            <h4 class="mt-2 text-[1.3125rem] leading-tight font-[800] text-navy [font-stretch:112%]">{s.title}</h4>
            <span class="mt-3 text-[0.9875rem] leading-relaxed text-ink/85">{s.body}</span>
          </li>
        ))}
      </ul>

      <p class="mt-6 flex items-center gap-3 rounded-xl border border-dashed border-ink/20 bg-white/40 px-5 py-4 text-ink/85">
        <span class="ic-chip ic-chip-you">TÚ</span>
        <span><span class="font-bold text-navy">Tu almacén:</span> recibes el pedido y despachas. Nosotros, todo lo demás.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .levels-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: var(--color-navy);
  }
  .level-more {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: rgb(11 31 51 / 0.3);
    text-underline-offset: 0.25em;
  }
  .level-more:hover { text-decoration-color: currentColor; }
  .tabs { display: none; }
  .panels { display: grid; gap: 0.75rem; }
  .panel { padding: 1.5rem; }
  .panel .watermark { font-size: 5rem; }

  /* Escritorio: pestañas a la izquierda y el nivel elegido a la derecha */
  @media (min-width: 1024px) {
    .levels-body { display: grid; grid-template-columns: 16.5rem 1fr; gap: 0.75rem; align-items: stretch; }
    .tabs { display: grid; gap: 0.625rem; align-content: start; }
    .levels.is-tabs .panel:not(.active) { display: none; }
    .levels.is-tabs .panel-ring { display: none; }
    .panel { padding: 2rem 2.25rem; }
    .panel .watermark { font-size: 7rem; }
  }
  .tab {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid rgb(11 31 51 / 0.08);
    background: rgb(255 255 255 / 0.8);
    color: var(--color-navy);
    box-shadow: 0 1px 2px rgb(11 31 51 / 0.05);
    transition: background-color 250ms, color 250ms, box-shadow 250ms;
    cursor: pointer;
  }
  .tab:hover { background: #fff; box-shadow: 0 12px 24px -18px rgb(11 31 51 / 0.45); }
  .tab[aria-selected='true'] { background: var(--color-navy); color: var(--color-paper); border-color: var(--color-navy); }
  /* Cambio automático: una línea que se llena muestra cuánto falta para el siguiente nivel */
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--color-sky);
  }
  .levels.autoplay .tab[aria-selected='true']::after { animation: tab-progress var(--dwell, 6s) linear forwards; }
  .levels.autoplay.paused .tab[aria-selected='true']::after { animation-play-state: paused; }
  @keyframes tab-progress { to { width: 100%; } }
  .tab[aria-selected='true'] .tab-label { color: var(--color-sky); }
  .tab[aria-selected='true'] :global(.track) { stroke: rgb(159 179 198 / 0.22); }
  .tab[aria-selected='true'] :global(.arc) { stroke: var(--color-sky); }
  .tab[aria-selected='true'] :global(.val) { color: var(--color-paper); }
  .levels.is-tabs .panel.active { animation: panel-in 450ms var(--ease-out-expo); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } }

</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-levels]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const wide = window.matchMedia('(min-width: 1024px)');

    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, n) => p.classList.toggle('active', n === i));
      if (focus) tabs[i].focus();
    };

    // Las pestañas solo existen en escritorio; en móvil se ven todos los niveles uno debajo del otro
    const sync = () => root.classList.toggle('is-tabs', wide.matches);
    sync();
    wide.addEventListener('change', sync);

    // Cambio automático de nivel en escritorio: avanza solo, se pausa con el cursor encima,
    // al recibir el foco o fuera de pantalla, y no corre si el usuario prefiere menos movimiento
    const DWELL = 6000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    root.style.setProperty('--dwell', `${DWELL}ms`);
    let current = 0;
    let timer: number | undefined;
    let visible = false;
    let hovering = false;
    let focused = false;

    const canRun = () => wide.matches && !reduce.matches && visible && !hovering && !focused && !document.hidden;
    const restartBar = () => {
      // Reinicia la animación de la línea de progreso en la pestaña activa
      root.classList.remove('autoplay');
      void root.offsetWidth;
      if (wide.matches && !reduce.matches) root.classList.add('autoplay');
    };
    const schedule = () => {
      window.clearTimeout(timer);
      timer = undefined;
      root.classList.toggle('paused', !canRun());
      if (!canRun()) return;
      timer = window.setTimeout(() => {
        remaining = DWELL;
        select((current + 1) % tabs.length);
        restartBar();
        schedule();
      }, remaining);
      startedAt = Date.now();
    };
    let remaining = DWELL;
    let startedAt = Date.now();
    const pause = () => {
      if (timer) remaining = Math.max(0, remaining - (Date.now() - startedAt));
      window.clearTimeout(timer);
      timer = undefined;
      root.classList.add('paused');
    };
    const resume = () => {
      if (canRun() && !timer) schedule();
    };

    root.addEventListener('mouseenter', () => { hovering = true; pause(); });
    root.addEventListener('mouseleave', () => { hovering = false; resume(); });
    root.addEventListener('focusin', () => { focused = true; pause(); });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node)) return;
      focused = false;
      resume();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : resume()));
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible ? resume() : pause();
    }, { threshold: 0.35 }).observe(root);
    wide.addEventListener('change', () => {
      restartBar();
      wide.matches ? resume() : pause();
    });

    // Al elegir un nivel a mano, el conteo vuelve a empezar desde ese nivel
    const choose = (i: number, focus = false) => {
      select(i, focus);
      remaining = DWELL;
      restartBar();
      pause();
      resume();
    };
    restartBar();

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => choose(i));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        choose((i + dir + tabs.length) % tabs.length, true);
      });
    });

    // Los enlaces a #nivel-N (p. ej. desde «Soluciones») abren ese nivel
    const openFromHash = () => {
      const m = location.hash.match(/^#nivel-(\d)$/);
      if (m) choose(Number(m[1]) - 1);
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }
</script>
