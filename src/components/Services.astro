---
import Icon from './Icon.astro';
import Printer from './Printer.astro';
import RingNum from './RingNum.astro';

// Niveles: se contratan de a uno, en orden, según lo que el negocio necesite.
const levels = [
  {
    id: 'desarrollo',
    level: 1,
    title: 'Desarrollo y digitalización de tu negocio',
    body: 'Creamos tu plataforma de e-commerce a la medida, aunque hoy tu empresa no tenga vida digital. Llevamos tu modelo físico (catálogo, condiciones, forma de vender) al entorno web.',
    result: 'Tu negocio, tal como funciona, ahora vende en línea.',
  },
  {
    id: 'ia',
    level: 2,
    title: 'Automatización inteligente con IA',
    body: 'Automatizamos tus procesos con IA para optimizar los tiempos y la calidad de tu operación.',
    result: 'Menos tareas manuales, respuestas más rápidas.',
  },
  {
    id: 'omnicanal',
    level: 3,
    title: 'Sincronización: tienda conectada',
    body: 'Integramos la tienda con el sistema administrativo (ERP) que tu empresa ya usa y centralizamos el inventario. Vendes al mismo tiempo en Mercado Libre, Amazon, eBay, Facebook Marketplace y más, desde un único panel de control.',
    result: 'Un inventario, todos los canales, sin cargar nada dos veces.',
  },
  {
    id: 'b2b',
    level: 4,
    title: 'E-Commerce avanzado B2B',
    body: 'Configuramos reglas de negocio específicas, control de stock y listas de precios dinámicas para ofrecer precios y condiciones exclusivas a cada cliente corporativo, de forma automática.',
    result: 'Cada cliente ve su precio, sin que tú lo calcules.',
  },
] as const;

// Acompañan cualquier nivel
const support = [
  {
    icon: 'megaphone',
    title: 'Marketing y tráfico digital',
    note: 'Acompañamiento',
    body: 'Atraemos a potenciales clientes a tu tienda con redes sociales, contenido y campañas publicitarias según el nicho de tu negocio.',
  },
  {
    icon: 'team',
    title: 'Gestión delegada',
    note: 'Acompañamiento',
    body: 'Tienda 100% automatizada y delegada: personal capacitado por Elanth la administra y tú te enfocas en recibir los pedidos.',
  },
  {
    icon: 'target',
    title: 'Posicionamiento SEO',
    note: 'Para buscadores y para IA',
    body: 'Optimizamos tu tienda para que aparezca en Google y en las respuestas de los asistentes de inteligencia artificial cuando tus clientes buscan lo que vendes.',
  },
] as const;

const channels = ['Tienda', 'M. Libre', 'Amazon', 'Marketplace'];
const priceRows = [
  { client: 'Ferretería Centro', list: 'Mayorista A', price: '−12%' },
  { client: 'Constructora Norte', list: 'Mayorista B', price: '−8%' },
  { client: 'Cliente final', list: 'Minorista', price: 'Base' },
];
---
<section id="servicios" class="mesh-soft text-ink" data-services>
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-24 lg:px-12">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-navy lg:col-span-7">Tus ventas en línea, de principio a fin.</h2>
      <p class="max-w-[36rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-2">
        E-Commerce 360° es nuestra solución llave en mano: no solo creamos tu tienda, también podemos centralizar y
        automatizar todos tus canales de venta para que evolucione tu forma de vender sin aumentar significativamente tu
        carga operativa.
      </p>
    </div>

    <div class="mt-12 grid gap-10 sm:mt-16 xl:grid-cols-12 xl:gap-8">
      <!-- La comandera: los pedidos de todos los canales en un solo lugar -->
      <div class="xl:col-span-4">
        <div class="xl:sticky xl:top-24">
          <Printer />
        </div>
      </div>

      <!-- Niveles -->
      <div class="levels xl:col-span-8" data-levels>
        <div class="levels-head">
          <RingNum value="360" progress={1} size={52} dark />
          <span>
            <span class="block text-xl font-[800] tracking-[-0.01em] text-paper [font-stretch:116%] sm:text-2xl">Avanza por niveles</span>
            <span class="mt-0.5 block text-sm text-fog sm:text-[0.9375rem]">Contrata lo que tu negocio necesita hoy y sube de nivel cuando quieras.</span>
          </span>
        </div>

        <div class="levels-body mt-3">
          <div class="tabs" role="tablist" aria-label="Niveles de E-Commerce 360°" aria-orientation="vertical">
            {levels.map((l, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${l.id}`}
                class="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`nivel-${l.level}`}
                tabindex={i === 0 ? 0 : -1}
                data-tab={i}
              >
                <RingNum value={l.level} progress={l.level / levels.length} size={46} />
                <span class="min-w-0 text-left">
                  <span class="tag-label tab-label block">Nivel {l.level}</span>
                  <span class="mt-1 block text-[0.9875rem] leading-snug font-bold [font-stretch:106%]">{l.title}</span>
                </span>
              </button>
            ))}
          </div>

          <div class="panels">
            {levels.map((l, i) => (
              <article id={`nivel-${l.level}`} class:list={['panel card-soft', { active: i === 0 }]} role="tabpanel" aria-labelledby={`tab-${l.id}`} data-panel={i}>
                <span class="watermark" aria-hidden="true">{l.level}</span>
                <div class="flex items-center gap-3">
                  <span class="panel-ring"><RingNum value={l.level} progress={l.level / levels.length} size={40} /></span>
                  <span class="tag-label">Nivel {l.level}</span>
                </div>
                <h3 class="display mt-4 max-w-[30rem] text-[clamp(1.75rem,3.2vw,2.5rem)] text-navy">{l.title}</h3>
                <p class="mt-4 max-w-[36rem] text-[1.0625rem] leading-relaxed text-ink/85">{l.body}</p>
                <p class="mt-4 flex items-start gap-2 font-semibold text-blue-ink">
                  <Icon name="arrow" class="mt-[0.2em] size-4 shrink-0" />
                  {l.result}
                </p>

                {/* Ilustración del nivel */}
                <div class="illus mt-7" aria-hidden="true">
                  {l.level === 1 && (
                    <div class="win">
                      <div class="win-bar"><span></span><span></span><span></span><i></i></div>
                      <div class="flex items-center justify-between px-4 pt-3.5">
                        <span class="h-2.5 w-24 rounded-full bg-navy"></span>
                        <span class="grid size-7 place-items-center rounded-full bg-blue-ink text-paper"><Icon name="bag" class="size-3.5" /></span>
                      </div>
                      <div class="grid grid-cols-3 gap-2.5 p-4">
                        {['circle', 'tri', 'square'].map((shape) => (
                          <div class="product">
                            <div class="thumb"><span class={`shape ${shape}`}></span></div>
                            <span class="mt-2 block h-1.5 w-4/5 rounded-full bg-navy/15"></span>
                            <span class="mt-1 block h-1.5 w-1/2 rounded-full bg-navy/10"></span>
                            <span class="buy">Agregar</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                  {l.level === 2 && (
                    <div class="chat">
                      <p class="bubble in">¿Tienen el cable THW 12 en rollo de 100 m?</p>
                      <p class="bubble out">
                        <span class="flex items-center gap-1.5 text-[0.6875rem] font-semibold text-sky"><Icon name="spark" class="size-3.5" />Asistente IA · al instante</span>
                        <span class="mt-1 block">Sí, quedan 142 rollos. ¿Te reservo 2 y te envío el enlace de pago?</span>
                      </p>
                      <p class="bubble in short">Sí, por favor.</p>
                    </div>
                  )}
                  {l.level === 3 && (
                    <div class="sync">
                      <div class="hub-box">
                        <Icon name="sync" class="size-5 text-sky" />
                        <span>
                          <span class="block text-[0.6875rem] text-fog">Inventario central</span>
                          <span class="tabular block text-xl font-bold text-paper">142</span>
                        </span>
                      </div>
                      <div class="grid flex-1 grid-cols-2 gap-2">
                        {channels.map((c) => (
                          <div class="chan">
                            <span class="text-[0.75rem] text-muted">{c}</span>
                            <span class="tabular flex items-center gap-1.5 font-bold text-navy"><Icon name="check" class="size-3.5 text-blue-ink" />142</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                  {l.level === 4 && (
                    <div class="prices">
                      <div class="row head"><span>Cliente</span><span>Lista</span><span>Precio</span></div>
                      {priceRows.map((r) => (
                        <div class="row"><span class="font-semibold text-navy">{r.client}</span><span>{r.list}</span><span class="tabular font-bold text-blue-ink">{r.price}</span></div>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Acompañamiento -->
    <div class="mt-16 sm:mt-20">
      <div class="grid gap-3 lg:grid-cols-12 lg:items-end">
        <h3 class="text-[clamp(1.5rem,3vw,2.125rem)] leading-tight font-[820] tracking-[-0.02em] text-navy [font-stretch:116%] lg:col-span-7">Acompañamos tu proceso con</h3>
        <p class="text-muted lg:col-span-5">Disponibles en cualquier nivel.</p>
      </div>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {support.map((s) => (
          <li class="card-soft flex flex-col p-6 sm:p-7">
            <span class="hex"><Icon name={s.icon} class="size-5" /></span>
            <span class="tag-label mt-5">{s.note}</span>
            <span class="mt-2 text-[1.3125rem] leading-tight font-[800] text-navy [font-stretch:112%]">{s.title}</span>
            <span class="mt-3 text-[0.9875rem] leading-relaxed text-ink/85">{s.body}</span>
          </li>
        ))}
      </ul>

      <p class="mt-6 flex items-center gap-3 rounded-xl border border-dashed border-ink/20 bg-white/40 px-5 py-4 text-ink/85">
        <span class="ic-chip ic-chip-you">TÚ</span>
        <span><span class="font-bold text-navy">Tu almacén:</span> recibes el pedido y despachas. Nosotros, todo lo demás.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .levels-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: var(--color-navy);
  }
  .tabs { display: none; }
  .panels { display: grid; gap: 0.75rem; }
  .panel { padding: 1.5rem; }
  .panel .watermark { font-size: 5rem; }

  /* Escritorio: pestañas a la izquierda y el nivel elegido a la derecha */
  @media (min-width: 1024px) {
    .levels-body { display: grid; grid-template-columns: 16.5rem 1fr; gap: 0.75rem; align-items: stretch; }
    .tabs { display: grid; gap: 0.625rem; align-content: start; }
    .levels.is-tabs .panel:not(.active) { display: none; }
    .levels.is-tabs .panel-ring { display: none; }
    .panel { padding: 2rem 2.25rem; }
    .panel .watermark { font-size: 7rem; }
  }
  .tab {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid rgb(11 31 51 / 0.08);
    background: rgb(255 255 255 / 0.8);
    color: var(--color-navy);
    box-shadow: 0 1px 2px rgb(11 31 51 / 0.05);
    transition: background-color 250ms, color 250ms, box-shadow 250ms;
    cursor: pointer;
  }
  .tab:hover { background: #fff; box-shadow: 0 12px 24px -18px rgb(11 31 51 / 0.45); }
  .tab[aria-selected='true'] { background: var(--color-navy); color: var(--color-paper); border-color: var(--color-navy); }
  /* Cambio automático: una línea que se llena muestra cuánto falta para el siguiente nivel */
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--color-sky);
  }
  .levels.autoplay .tab[aria-selected='true']::after { animation: tab-progress var(--dwell, 6s) linear forwards; }
  .levels.autoplay.paused .tab[aria-selected='true']::after { animation-play-state: paused; }
  @keyframes tab-progress { to { width: 100%; } }
  .tab[aria-selected='true'] .tab-label { color: var(--color-sky); }
  .tab[aria-selected='true'] :global(.track) { stroke: rgb(159 179 198 / 0.22); }
  .tab[aria-selected='true'] :global(.arc) { stroke: var(--color-sky); }
  .tab[aria-selected='true'] :global(.val) { color: var(--color-paper); }
  .levels.is-tabs .panel.active { animation: panel-in 450ms var(--ease-out-expo); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } }

  /* Ilustraciones */
  .illus { position: relative; max-width: 30rem; }
  .win { overflow: hidden; border-radius: 12px; border: 1px solid rgb(11 31 51 / 0.1); background: #f7fafc; }
  .win-bar { display: flex; align-items: center; gap: 5px; padding: 0.5rem 0.75rem; border-bottom: 1px solid rgb(11 31 51 / 0.08); }
  .win-bar span { width: 7px; height: 7px; border-radius: 50%; background: rgb(11 31 51 / 0.18); }
  .win-bar i { flex: 1; height: 0.625rem; margin-left: 0.5rem; border-radius: 999px; background: rgb(11 31 51 / 0.07); }
  .product { padding: 0.5rem; border-radius: 9px; background: #fff; border: 1px solid rgb(11 31 51 / 0.07); }
  .thumb { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: 6px; background: var(--color-ice); }
  .shape { display: block; width: 32%; aspect-ratio: 1; background: var(--color-blue); }
  .shape.circle { border-radius: 50%; }
  .shape.tri { clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .shape.square { border-radius: 4px; background: var(--color-blue-ink); }
  .buy {
    display: block;
    margin-top: 0.5rem;
    padding: 0.25rem 0;
    border-radius: 999px;
    background: var(--color-blue-ink);
    color: var(--color-paper);
    font-size: 0.625rem;
    font-weight: 700;
    text-align: center;
  }
  .chat { display: grid; gap: 0.5rem; padding: 1rem; border-radius: 12px; background: var(--color-ice); }
  .bubble { max-width: 85%; padding: 0.625rem 0.875rem; border-radius: 14px; font-size: 0.875rem; line-height: 1.45; }
  .bubble.in { justify-self: start; background: #fff; color: var(--color-ink); border-bottom-left-radius: 4px; }
  .bubble.out { justify-self: end; background: var(--color-navy); color: var(--color-paper); border-bottom-right-radius: 4px; }
  .bubble.short { max-width: 60%; }
  .sync { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.5rem; padding: 0.75rem; border-radius: 12px; background: var(--color-ice); }
  .hub-box { display: flex; align-items: center; gap: 0.75rem; padding: 0.875rem 1rem; border-radius: 10px; background: var(--color-navy); }
  .chan { display: flex; flex-direction: column; gap: 0.125rem; padding: 0.5rem 0.75rem; border-radius: 9px; background: #fff; }
  .prices { overflow: hidden; border-radius: 12px; border: 1px solid rgb(11 31 51 / 0.1); background: #fff; font-size: 0.875rem; }
  .prices .row { display: grid; grid-template-columns: 1.4fr 1fr 0.7fr; gap: 0.75rem; padding: 0.625rem 1rem; border-top: 1px solid rgb(11 31 51 / 0.07); color: var(--color-muted); }
  .prices .row.head { border-top: 0; background: var(--color-ice); font-size: 0.75rem; font-weight: 600; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-levels]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const wide = window.matchMedia('(min-width: 1024px)');

    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, n) => p.classList.toggle('active', n === i));
      if (focus) tabs[i].focus();
    };

    // Las pestañas solo existen en escritorio; en móvil se ven todos los niveles uno debajo del otro
    const sync = () => root.classList.toggle('is-tabs', wide.matches);
    sync();
    wide.addEventListener('change', sync);

    // Cambio automático de nivel en escritorio: avanza solo, se pausa con el cursor encima,
    // al recibir el foco o fuera de pantalla, y no corre si el usuario prefiere menos movimiento
    const DWELL = 6000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    root.style.setProperty('--dwell', `${DWELL}ms`);
    let current = 0;
    let timer: number | undefined;
    let visible = false;
    let hovering = false;
    let focused = false;

    const canRun = () => wide.matches && !reduce.matches && visible && !hovering && !focused && !document.hidden;
    const restartBar = () => {
      // Reinicia la animación de la línea de progreso en la pestaña activa
      root.classList.remove('autoplay');
      void root.offsetWidth;
      if (wide.matches && !reduce.matches) root.classList.add('autoplay');
    };
    const schedule = () => {
      window.clearTimeout(timer);
      timer = undefined;
      root.classList.toggle('paused', !canRun());
      if (!canRun()) return;
      timer = window.setTimeout(() => {
        remaining = DWELL;
        select((current + 1) % tabs.length);
        restartBar();
        schedule();
      }, remaining);
      startedAt = Date.now();
    };
    let remaining = DWELL;
    let startedAt = Date.now();
    const pause = () => {
      if (timer) remaining = Math.max(0, remaining - (Date.now() - startedAt));
      window.clearTimeout(timer);
      timer = undefined;
      root.classList.add('paused');
    };
    const resume = () => {
      if (canRun() && !timer) schedule();
    };

    root.addEventListener('mouseenter', () => { hovering = true; pause(); });
    root.addEventListener('mouseleave', () => { hovering = false; resume(); });
    root.addEventListener('focusin', () => { focused = true; pause(); });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node)) return;
      focused = false;
      resume();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : resume()));
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible ? resume() : pause();
    }, { threshold: 0.35 }).observe(root);
    wide.addEventListener('change', () => {
      restartBar();
      wide.matches ? resume() : pause();
    });

    // Al elegir un nivel a mano, el conteo vuelve a empezar desde ese nivel
    const choose = (i: number, focus = false) => {
      select(i, focus);
      remaining = DWELL;
      restartBar();
      pause();
      resume();
    };
    restartBar();

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => choose(i));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        choose((i + dir + tabs.length) % tabs.length, true);
      });
    });

    // Los enlaces a #nivel-N (p. ej. desde «Soluciones») abren ese nivel
    const openFromHash = () => {
      const m = location.hash.match(/^#nivel-(\d)$/);
      if (m) choose(Number(m[1]) - 1);
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }
</script>
