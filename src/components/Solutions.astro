---
import Icon from './Icon.astro';

// Caminos en escalones: cada tarjeta sube un peldaño. Por defecto, las soluciones de la portada;
// otras páginas (p. ej. Elanth Media) pasan sus propios caminos.
type Item = { icon: string; audience: string; title: string; body: string; link: string; href: string };
interface Props {
  id?: string;
  title?: string;
  intro?: string;
  items?: readonly Item[];
  help?: { text: string; link: string; href: string };
}

const defaults = [
  {
    icon: 'sprout',
    audience: 'Emprendedores',
    title: 'Quiero empezar a vender online',
    body: 'Creamos tu primera tienda online con catálogo, carrito de compras y las funciones necesarias para comenzar.',
    link: 'Conocer la solución inicial',
    href: '#nivel-1',
  },
  {
    icon: 'store',
    audience: 'Negocios',
    title: 'Ya tengo un negocio y quiero crecer',
    body: 'Llevamos tus ventas a internet y conectamos tu catálogo, inventario y canales comerciales para reducir tareas manuales.',
    link: 'Conocer la solución para negocios',
    href: '#nivel-3',
  },
  {
    icon: 'building',
    audience: 'Empresas',
    title: 'Necesito una solución empresarial',
    body: 'Desarrollamos plataformas a medida, integramos sistemas administrativos y automatizamos operaciones comerciales complejas.',
    link: 'Conocer la solución empresarial',
    href: '#nivel-4',
  },
] as const;

const {
  id = 'soluciones',
  title = 'Te ofrecemos soluciones en cualquier etapa de tu negocio',
  intro = 'Empieza donde estás hoy. Cada camino arranca en el nivel que tu negocio necesita y crece contigo.',
  items = defaults,
  help = { text: '¿No sabes cuál elegir?', link: 'Te ayudamos en la asesoría gratuita', href: '#asesoria' },
} = Astro.props;
---
<section id={id} class="mesh-soft text-ink">
  <div class="mx-auto max-w-[90rem] px-4 py-24 sm:px-8 sm:py-32 lg:px-12">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-navy lg:col-span-7">{title}</h2>
      <p class="max-w-[34rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-2">
        {intro}
      </p>
    </div>

    <ol class="stairs mt-14 lg:mt-20" style={`--n:${items.length}`}>
      {items.map((s, i) => (
        <li class="step" style={`--i:${i}`}>
          <a href={s.href} class="step-card card-soft group">
            <span class="watermark" aria-hidden="true">{i + 1}</span>
            <span class="flex items-center gap-4">
              <span class="hex">
                <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {Array.from({ length: Math.min(i + 1, 3) }, (_, k) => (
                    <path d={`M6 ${14 + (Math.min(i + 1, 3) - 1) * 2.5 - k * 5}l6-5 6 5`} />
                  ))}
                </svg>
              </span>
              <span class="tag-label">{s.audience}</span>
            </span>
            <span class="mt-6 block text-[1.375rem] leading-tight font-[800] tracking-[-0.01em] text-navy [font-stretch:112%] sm:text-[1.5rem]">{s.title}</span>
            <span class="mt-3 block text-[0.9875rem] leading-relaxed text-ink/85">{s.body}</span>
            <span class="mt-auto flex items-start gap-2 pt-6 text-[0.9375rem] font-semibold text-blue-ink">
              <Icon name="arrow" class="mt-[0.2em] size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" />
              {s.link}
            </span>
          </a>
        </li>
      ))}
    </ol>

    <p class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9875rem] text-muted">
      {help.text}
      <a href={help.href} class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-navy underline decoration-navy/30 underline-offset-4 hover:decoration-navy">
        {help.link} <Icon name="arrow" class="size-4" />
      </a>
    </p>
  </div>
</section>

<style>
  .stairs { display: grid; gap: 1rem; }
  .step-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem 1.5rem;
    transition: transform 300ms var(--ease-out-quart), box-shadow 300ms;
  }
  .step-card:hover { transform: translateY(-4px); box-shadow: 0 1px 2px rgb(11 31 51 / 0.06), 0 26px 44px -24px rgb(11 31 51 / 0.45); }
  /* Escalones: todas las tarjetas apoyan en la misma base y cada una sube un peldaño */
  @media (min-width: 768px) {
    .stairs { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .stairs { grid-template-columns: repeat(var(--n), 1fr); align-items: end; gap: 1.25rem; }
    .step-card { min-height: calc(21rem + var(--i) * 3.5rem); padding: 2rem 1.75rem; }
  }
</style>
