---
import Icon from './Icon.astro';

const solutions = [
  {
    icon: 'sprout',
    audience: 'Emprendedores',
    title: 'Quiero empezar a vender online',
    body: 'Creamos tu primera tienda online con catálogo, carrito de compras y las funciones necesarias para comenzar.',
    link: 'Conocer la solución inicial',
    href: '#nivel-1',
  },
  {
    icon: 'store',
    audience: 'Negocios',
    title: 'Ya tengo un negocio y quiero crecer',
    body: 'Llevamos tus ventas a internet y conectamos tu catálogo, inventario y canales comerciales para reducir tareas manuales.',
    link: 'Conocer la solución para negocios',
    href: '#nivel-3',
  },
  {
    icon: 'building',
    audience: 'Empresas',
    title: 'Necesito una solución empresarial',
    body: 'Desarrollamos plataformas a medida, integramos sistemas administrativos y automatizamos operaciones comerciales complejas.',
    link: 'Conocer la solución empresarial',
    href: '#nivel-4',
  },
] as const;
---
<section id="soluciones" class="circuit-grid bg-ice text-ink">
  <div class="mx-auto max-w-[90rem] px-4 py-24 sm:px-8 sm:py-32 lg:px-12">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-navy lg:col-span-7">¿Qué solución busca tu negocio?</h2>
      <p class="max-w-[34rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-2">
        Empieza donde estás hoy. Cada camino arranca en el nivel que tu negocio necesita y crece contigo.
      </p>
    </div>

    <ul class="paths mt-14 lg:mt-20">
      {solutions.map((s) => (
        <li class="path">
          <span class="pad" aria-hidden="true"></span>
          <a href={s.href} class="route group">
            <span class="flex items-center gap-3 sm:col-start-1 sm:row-start-1">
              <span class="glyph"><Icon name={s.icon} class="size-5" /></span>
              <span class="tag">{s.audience}</span>
            </span>
            <span class="min-w-0 sm:col-start-2 sm:row-span-2">
              <span class="block text-[1.25rem] leading-tight font-[780] tracking-[-0.01em] text-navy [font-stretch:110%] sm:text-[1.4375rem]">{s.title}</span>
              <span class="mt-2.5 block max-w-[46rem] text-[0.9875rem] leading-relaxed text-ink/85">{s.body}</span>
            </span>
            <span class="more inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold text-blue-ink sm:col-start-3 sm:row-start-1 sm:justify-self-end">
              {s.link}
              <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.9875rem] text-muted sm:pl-12">
      ¿No sabes cuál elegir?
      <a href="#asesoria" class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-navy underline decoration-navy/30 underline-offset-4 hover:decoration-navy">
        Te ayudamos en la asesoría gratuita <Icon name="arrow" class="size-4" />
      </a>
    </p>
  </div>
</section>

<style>
  /* Tres caminos conectados al mismo bus que los niveles */
  .paths {
    --g: 2rem;
    --line: rgb(23 105 143 / 0.45);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-left: var(--g);
  }
  .path { --ty: 2.25rem; position: relative; }
  .path::before {
    content: '';
    position: absolute;
    top: calc(var(--ty) - 1px);
    left: calc(0.75rem - var(--g));
    width: calc(var(--g) - 0.75rem);
    height: 2px;
    background: var(--line);
    transition: background-color 300ms;
  }
  .path::after {
    content: '';
    position: absolute;
    top: -0.875rem;
    bottom: 0;
    left: calc(0.75rem - var(--g) - 1px);
    width: 2px;
    background: var(--line);
  }
  .path:first-child::after { top: var(--ty); }
  .path:last-child::after { bottom: auto; height: calc(var(--ty) + 0.875rem); }
  .pad {
    position: absolute;
    z-index: 1;
    top: calc(var(--ty) - 6px);
    left: calc(0.75rem - var(--g) - 6px);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--color-blue-ink);
    background: var(--color-ice);
    transition: background-color 300ms, border-color 300ms;
  }
  .path:hover::before,
  .path:focus-within::before { background: var(--color-navy); }
  .path:hover .pad,
  .path:focus-within .pad { background: var(--color-navy); border-color: var(--color-navy); }

  .route {
    display: grid;
    gap: 0.875rem;
    padding: 1.25rem;
    border-radius: 10px;
    border: 1px solid rgb(11 31 51 / 0.14);
    background: #fff;
    transition: border-color 300ms, box-shadow 300ms;
  }
  .route:hover,
  .route:focus-visible { border-color: var(--color-navy); box-shadow: 0 12px 24px -16px rgb(11 31 51 / 0.45); }
  .glyph {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    background: var(--color-navy);
    color: var(--color-sky);
  }
  .tag {
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--color-ice);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-navy);
  }
  @media (min-width: 640px) {
    .paths { --g: 3rem; }
    .path { --ty: 2.6rem; }
    .path::before { left: calc(1rem - var(--g)); width: calc(var(--g) - 1rem); }
    .path::after,
    .pad { left: calc(1rem - var(--g) - 1px); }
    .pad { left: calc(1rem - var(--g) - 6px); }
    .route {
      grid-template-columns: 11.5rem 1fr auto;
      column-gap: 1.75rem;
      padding: 1.5rem 1.75rem;
    }
  }
</style>
