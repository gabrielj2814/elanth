---
// Código de barras decorativo y determinista a partir de un texto.
interface Props {
  value: string;
  class?: string;
}
const { value, class: className } = Astro.props;

let seed = 0;
for (const ch of value) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
const bars: { x: number; w: number }[] = [];
let x = 0;
for (let i = 0; i < 46; i++) {
  seed = (seed * 1103515245 + 12345) >>> 0;
  const w = 1 + (seed % 3);
  const gap = 1 + ((seed >> 4) % 2);
  bars.push({ x, w });
  x += w + gap;
}
---
<svg class={className} viewBox={`0 0 ${x} 24`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="24" fill="currentColor" />)}
</svg>
