---
import Icon from './Icon.astro';

const upcoming = [
  { name: 'Elanth Code', body: 'Desarrollo avanzado de software, integraciones complejas y aplicaciones a la medida.' },
  { name: 'Elanth Media', body: 'Producción de contenido, diseño, branding y estrategias de comunicación visual.' },
  { name: 'Elanth Games', body: 'Experiencias interactivas y proyectos orientados a la industria de los videojuegos.' },
  { name: 'Elanth Industry', body: 'Desarrollo de software y soluciones avanzadas para la industria.' },
];
---
<section id="ecosistema" class="bg-ice text-ink">
  <div class="mx-auto max-w-[90rem] px-4 py-24 sm:px-8 sm:py-32 lg:px-12">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-navy lg:col-span-7">
        Hoy, comercio electrónico. Mañana, un hub tecnológico.
      </h2>
      <p class="max-w-[34rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-2">
        A medida que crecemos, Elanth se convertirá en un ecosistema de departamentos especializados, listos para resolver
        cualquier reto de nuestros clientes. Estos son los que vienen.
      </p>
    </div>

    <!-- Riel de pedidos -->
    <div class="relative mt-16 lg:mt-24">
      <div class="rail absolute inset-x-0 top-0 hidden h-3 rounded-full lg:block" aria-hidden="true"></div>
      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4 lg:pt-1.5">
        <li class="hang">
          <article class="ticket-v paper paper-torn-bottom h-full bg-white px-5 pt-6 pb-8">
            <h3 class="text-xl font-[800] text-navy [font-stretch:114%]">E-Commerce 360°</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink/85">
              Tiendas, omnicanalidad, B2B, gestión delegada y marketing.
            </p>
            <div class="tear-line mt-5 text-ink"></div>
            <p class="mt-3 flex items-center justify-between gap-2 font-mono text-[0.6875rem] text-navy [font-stretch:82%]">
              <span>Estado</span>
              <span class="flex items-center gap-1.5 font-semibold"><Icon name="check" class="size-3.5" />En servicio</span>
            </p>
            <a href="#asesoria" class="mt-5 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-blue-ink underline decoration-blue-ink/40 underline-offset-4 hover:decoration-blue-ink">
              Pedir asesoría <Icon name="arrow" class="size-4" />
            </a>
          </article>
        </li>
        {upcoming.map((u, i) => (
          <li class="hang" style={`--drop:${[1.5, 0.5, 2.25, 1][i]}rem`}>
            <article class="ticket-v paper paper-torn-bottom relative h-full overflow-hidden px-5 pt-6 pb-8">
              <h3 class="text-xl font-[800] text-navy [font-stretch:114%]">{u.name}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink/75">{u.body}</p>
              <div class="tear-line mt-4 text-ink"></div>
              <p class="mt-3 flex items-center justify-between gap-2 font-mono text-[0.6875rem] text-muted [font-stretch:82%]">
                <span>Estado</span>
                <span class="flex items-center gap-1.5 text-amber-ink"><Icon name="clock" class="size-3.5" />En preparación</span>
              </p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .rail {
    background: linear-gradient(to bottom, #50667e, var(--color-slate));
    box-shadow: 0 6px 10px -6px rgb(11 31 51 / 0.5), inset 0 1px 0 rgb(255 255 255 / 0.25);
  }
  @media (min-width: 1024px) {
    .hang { position: relative; padding-top: calc(1.25rem + var(--drop, 0rem)); }
    .hang::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      translate: -50% 0;
      width: 0.875rem;
      height: calc(1.6rem + var(--drop, 0rem));
      border-radius: 3px;
      background: linear-gradient(to right, #8aa0b6, #c9d6e2 45%, #6f859c);
      box-shadow: 0 2px 3px rgb(11 31 51 / 0.3);
      z-index: 2;
    }
  }
  .ticket-v { filter: drop-shadow(0 12px 16px rgb(11 31 51 / 0.14)) drop-shadow(0 1px 2px rgb(11 31 51 / 0.18)); }
</style>
