---
// Botón flotante que abre WhatsApp con el mensaje ya escrito.
import { siWhatsapp } from 'simple-icons';
import { whatsappUrl } from '../config';
---
{whatsappUrl && (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener"
    class="wa group fixed right-4 bottom-4 z-50 flex items-center gap-3 sm:right-6 sm:bottom-6"
    aria-label="Escríbenos por WhatsApp (se abre en una pestaña nueva)"
  >
    <span class="wa-label hidden rounded-full bg-paper px-4 py-2 text-sm font-semibold text-navy shadow-[0_10px_24px_-12px_rgb(3_10_18/0.6)] md:block">
      ¿Hablamos por WhatsApp?
    </span>
    <span class="wa-dot grid size-14 place-items-center rounded-full text-white">
      <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true" focusable="false">
        <path d={siWhatsapp.path} />
      </svg>
    </span>
  </a>
)}

<style>
  .wa {
    margin-bottom: env(safe-area-inset-bottom);
  }
  .wa-dot {
    background: #25d366;
    box-shadow: 0 14px 28px -10px rgb(3 10 18 / 0.55), 0 0 0 4px rgb(37 211 102 / 0.18);
    transition: transform 250ms var(--ease-out-quart), box-shadow 250ms var(--ease-out-quart);
  }
  .wa:hover .wa-dot,
  .wa:focus-visible .wa-dot {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 18px 32px -10px rgb(3 10 18 / 0.6), 0 0 0 6px rgb(37 211 102 / 0.22);
  }
  .wa:focus-visible { outline: none; }
  .wa:focus-visible .wa-dot { outline: 2px solid var(--color-teal); outline-offset: 4px; }
  /* La etiqueta se asoma al pasar el cursor */
  .wa-label {
    opacity: 0;
    translate: 0.5rem 0;
    transition: opacity 250ms var(--ease-out-quart), translate 250ms var(--ease-out-quart);
    pointer-events: none;
  }
  .wa:hover .wa-label,
  .wa:focus-visible .wa-label {
    opacity: 1;
    translate: 0 0;
  }
</style>
