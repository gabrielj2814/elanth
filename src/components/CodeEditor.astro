---
// Editor de demostración: una regla de negocio y una integración, con la terminal confirmando cada paso.
// Cada línea es una lista de fragmentos [clase, texto] para resaltar la sintaxis sin librerías.
type Line = [string, string][];

const files: { name: string; lines: Line[]; log: string[] }[] = [
  {
    name: 'precios-b2b.ts',
    lines: [
      [['c', '// Cada cliente ve su precio, sin cálculos a mano']],
      [['k', 'export function '], ['f', 'precioPara'], ['p', '(cliente, producto) {']],
      [['p', '  '], ['k', 'const '], ['v', 'lista'], ['p', ' = listas[cliente.segmento]']],
      [['p', '  '], ['k', 'const '], ['v', 'base'], ['p', ' = producto.precio * lista.factor']],
      [['p', '  '], ['k', 'return '], ['p', 'cliente.volumen > '], ['n', '100']],
      [['p', '    ? base * '], ['n', '0.95']],
      [['p', '    : base']],
      [['p', '}']],
    ],
    log: ['[ok] 48 listas de precios cargadas', '[ok] regla aplicada a «Mayorista B»', '[ok] desplegado en la tienda'],
  },
  {
    name: 'integracion-erp.ts',
    lines: [
      [['c', '// Un pedido entra una vez y llega a todos lados']],
      [['f', 'on'], ['p', '('], ['s', "'pedido.creado'"], ['p', ', '], ['k', 'async '], ['p', '(pedido) => {']],
      [['p', '  '], ['k', 'await '], ['p', 'erp.'], ['f', 'facturar'], ['p', '(pedido)']],
      [['p', '  '], ['k', 'await '], ['p', 'inventario.'], ['f', 'descontar'], ['p', '(pedido.items)']],
      [['p', '  '], ['k', 'await '], ['p', 'canales.'], ['f', 'sincronizar'], ['p', '(['], ['s', "'tienda'"], ['p', ', '], ['s', "'app'"], ['p', '])']],
      [['p', '  '], ['k', 'await '], ['p', 'ia.'], ['f', 'avisar'], ['p', '(pedido.cliente)']],
      [['p', '})']],
    ],
    log: ['[ok] pedido 1042 facturado en el ERP', '[ok] inventario actualizado', '[ok] 2 canales sincronizados'],
  },
];
---
<div class="editor mx-auto w-full max-w-[34rem]" data-editor>
  <div class="win">
    <div class="bar">
      <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
      <div class="tabs" role="tablist" aria-label="Archivos de demostración">
        {files.map((f, i) => (
          <button type="button" role="tab" class="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{f.name}</button>
        ))}
      </div>
      <span class="demo">Demostración</span>
    </div>

    {files.map((f, i) => (
      <div class="pane" data-pane={i} hidden={i !== 0}>
        <pre class="code" aria-label={`Código de demostración: ${f.name}`}><code>{f.lines.map((l, n) => (
          <span class="ln" style={`--i:${n}`}><span class="num" aria-hidden="true">{n + 1}</span>{l.map(([cls, txt]) => <span class={`t-${cls}`}>{txt}</span>)}</span>
        ))}</code></pre>
        <div class="term" aria-label="Terminal">
          {f.log.map((line, n) => (
            <p class="out" style={`--i:${n}`}><span class="ok">{line.slice(0, 4)}</span>{line.slice(4)}</p>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .win {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgb(107 187 224 / 0.22);
    background: var(--color-navy-deep);
    box-shadow: 0 40px 70px -35px rgb(0 0 0 / 0.85);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    background: var(--color-slate);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .lights { display: flex; gap: 6px; flex-shrink: 0; }
  .lights span { width: 10px; height: 10px; border-radius: 50%; background: rgb(159 179 198 / 0.35); }
  .lights span:first-child { background: var(--color-electric-soft); }
  .tabs { display: flex; gap: 2px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .tab {
    flex-shrink: 0;
    padding: 0.375rem 0.625rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-stretch: 82%;
    font-size: 0.6875rem;
    color: var(--color-fog);
    transition: background-color 200ms, color 200ms;
  }
  .tab:hover { color: var(--color-paper); }
  .tab[aria-selected='true'] { background: var(--color-navy-deep); color: var(--color-paper); }
  .demo {
    margin-left: auto;
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgb(159 179 198 / 0.35);
    font-family: var(--font-mono);
    font-stretch: 82%;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fog);
  }
  @media (max-width: 420px) { .demo { display: none; } }

  .code {
    margin: 0;
    padding: 1.125rem 1rem 1.25rem 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-stretch: 85%;
    font-size: 0.75rem;
    line-height: 1.85;
    color: var(--color-paper);
    tab-size: 2;
  }
  @media (min-width: 640px) { .code { font-size: 0.8125rem; } }
  .ln { display: block; white-space: pre; }
  .num {
    display: inline-block;
    width: 2.75rem;
    padding-right: 1rem;
    text-align: right;
    color: rgb(159 179 198 / 0.35);
    user-select: none;
  }
  .t-k { color: var(--color-sky); }
  .t-f { color: var(--color-electric-soft); }
  .t-s { color: var(--color-amber); }
  .t-n { color: var(--color-coral); }
  .t-c { color: rgb(159 179 198 / 0.6); font-style: italic; }
  .t-v, .t-p { color: var(--color-paper); }

  .term {
    padding: 0.875rem 1rem 1rem;
    border-top: 1px solid rgb(107 187 224 / 0.15);
    background: rgb(0 0 0 / 0.25);
    font-family: var(--font-mono);
    font-stretch: 85%;
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--color-fog);
  }
  .ok { color: var(--color-teal); }

  /* Las líneas se escriben y la terminal responde, una vez por pestaña */
  .pane.play .ln { animation: type 500ms var(--ease-out-quart) both; animation-delay: calc(var(--i) * 140ms); }
  .pane.play .out { animation: type 400ms var(--ease-out-quart) both; animation-delay: calc(1300ms + var(--i) * 420ms); }
  @keyframes type {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-editor]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let visible = false;

    const show = (i: number) => {
      current = i;
      tabs.forEach((t, n) => t.setAttribute('aria-selected', String(n === i)));
      panes.forEach((p, n) => {
        p.hidden = n !== i;
        p.classList.remove('play');
      });
      if (!reduce) {
        void panes[i].offsetWidth;
        panes[i].classList.add('play');
      }
    };

    const start = () => {
      if (reduce || timer || !visible || document.hidden) return;
      timer = window.setInterval(() => show((current + 1) % panes.length), 7000);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    tabs.forEach((t, n) =>
      t.addEventListener('click', () => {
        stop();
        show(n);
        start();
      }),
    );

    let first = true;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && first) {
        first = false;
        show(0);
      }
      visible ? start() : stop();
    }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
