---
// Teléfono de demostración: las notificaciones de redes avanzan hasta convertirse en ventas.
import Icon from './Icon.astro';
import { siWhatsapp } from 'simple-icons';

const stages = [
  { id: 'like', label: 'Like' },
  { id: 'comment', label: 'Comentario' },
  { id: 'dm', label: 'Mensaje' },
  { id: 'wa', label: 'WhatsApp' },
  { id: 'sale', label: 'Venta' },
];

const events = [
  { stage: 'like', icon: 'heart', title: 'Le gustó tu reel a 48 personas', meta: 'Reel · hace 2 min' },
  { stage: 'comment', icon: 'chat', title: 'Nuevo comentario: «¿Hacen envíos?»', meta: 'Post · respondido' },
  { stage: 'dm', icon: 'chat', title: 'Mensaje directo: «¿Cuánto cuesta el combo?»', meta: 'Redirigido a WhatsApp' },
  { stage: 'wa', icon: 'wa', title: 'Nueva conversación en WhatsApp', meta: 'Cliente interesado' },
  { stage: 'sale', icon: 'bag', title: 'Venta cerrada: 2 unidades', meta: 'Pedido confirmado' },
] as const;
---
<div class="feed-phone mx-auto w-full max-w-[22rem]" data-feed-phone>
  <div class="phone">
    <div class="screen">
      <div class="flex items-center justify-between gap-3 px-4 pt-4">
        <div class="flex items-center gap-2.5">
          <span class="avatar" aria-hidden="true"></span>
          <span>
            <span class="block text-sm font-bold text-paper [font-stretch:106%]">tunegocio</span>
            <span class="block text-[0.6875rem] text-fog">Notificaciones</span>
          </span>
        </div>
        <span class="demo">Demostración</span>
      </div>

      <ol class="mt-4 flex flex-col gap-2 px-3" data-feed-list aria-label="Actividad en redes (demostración)">
        {events.slice(0, 3).reverse().map((e) => (
          <li class="note" data-stage={e.stage}>
            <span class:list={['note-icon', `is-${e.stage}`]}>
              {e.icon === 'wa' ? (
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
              ) : (
                <Icon name={e.icon} class="size-4" />
              )}
            </span>
            <span class="min-w-0">
              <span class="block text-[0.8125rem] leading-snug font-semibold text-paper">{e.title}</span>
              <span class="mt-0.5 block text-[0.6875rem] text-fog">{e.meta}</span>
            </span>
          </li>
        ))}
      </ol>

      <!-- De like a venta -->
      <div class="funnel mx-3 mt-auto mb-3" aria-label="Del like a la venta">
        <ol class="flex items-center justify-between gap-1">
          {stages.map((s, i) => (
            <li class="stage" data-stage-dot={s.id} class:list={{ on: i <= 2 }}>
              <span class="dot" aria-hidden="true"></span>
              <span class="text-[0.625rem] font-semibold">{s.label}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  {events.map((e) => (
    <template data-feed-item>
      <li class="note" data-stage={e.stage}>
        <span class:list={['note-icon', `is-${e.stage}`]}>
          {e.icon === 'wa' ? (
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
          ) : (
            <Icon name={e.icon} class="size-4" />
          )}
        </span>
        <span class="min-w-0">
          <span class="block text-[0.8125rem] leading-snug font-semibold text-paper">{e.title}</span>
          <span class="mt-0.5 block text-[0.6875rem] text-fog">{e.meta}</span>
        </span>
      </li>
    </template>
  ))}
</div>

<style>
  .phone {
    padding: 0.625rem;
    border-radius: 2.25rem;
    background: var(--color-slate);
    box-shadow: 0 40px 70px -35px rgb(0 0 0 / 0.85), inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .screen {
    display: flex;
    flex-direction: column;
    height: 30rem;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-navy-deep);
  }
  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: conic-gradient(var(--color-coral), var(--color-sky), var(--color-teal), var(--color-coral));
    box-shadow: inset 0 0 0 3px var(--color-navy-deep);
  }
  .demo {
    padding: 0.125rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgb(159 179 198 / 0.35);
    font-family: var(--font-mono);
    font-stretch: 82%;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fog);
  }
  .note {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.875rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(107 187 224 / 0.12);
  }
  .note-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(107 187 224 / 0.14);
    color: var(--color-sky);
  }
  .note-icon.is-like { background: rgb(255 107 107 / 0.16); color: var(--color-coral); }
  .note-icon.is-wa { background: rgb(37 211 102 / 0.16); color: #4ade80; }
  .note-icon.is-sale { background: rgb(25 195 177 / 0.16); color: var(--color-teal); }

  .funnel {
    padding: 0.75rem 0.625rem;
    border-radius: 0.875rem;
    background: rgb(255 255 255 / 0.04);
  }
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    color: rgb(159 179 198 / 0.6);
    transition: color 300ms;
  }
  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: rgb(159 179 198 / 0.25);
    transition: background-color 300ms, box-shadow 300ms;
  }
  .stage.on { color: var(--color-paper); }
  .stage.on .dot { background: var(--color-coral); }
  .stage.now .dot { box-shadow: 0 0 0 4px rgb(255 107 107 / 0.25); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-feed-phone]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (root && !reduce.matches) {
    const list = root.querySelector<HTMLOListElement>('[data-feed-list]')!;
    const items = [...root.querySelectorAll<HTMLTemplateElement>('template[data-feed-item]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-stage-dot]')];
    let next = 3;
    let timer: number | undefined;
    let visible = false;

    const step = () => {
      const node = items[next % items.length].content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      const stage = node.dataset.stage!;
      next++;
      list.prepend(node);
      const h = node.getBoundingClientRect().height;
      node.animate(
        [{ height: '0px', opacity: 0, marginBottom: '-8px' }, { height: `${h}px`, opacity: 1, marginBottom: '0px' }],
        { duration: 600, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
      );
      while (list.children.length > 4) list.lastElementChild!.remove();
      const idx = dots.findIndex((d) => d.dataset.stageDot === stage);
      dots.forEach((d, i) => {
        d.classList.toggle('on', i <= idx);
        d.classList.toggle('now', i === idx);
      });
    };

    const start = () => {
      if (timer || !visible || document.hidden) return;
      timer = window.setInterval(step, 2600);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible ? start() : stop();
    }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
