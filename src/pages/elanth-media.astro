---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import WhatsApp from '../components/WhatsApp.astro';
import MediaFeed from '../components/MediaFeed.astro';
import Solutions from '../components/Solutions.astro';
import RingNum from '../components/RingNum.astro';
import { asset, whatsappLink, mediaWhatsappMessage } from '../config';

// Contenido de «Paquetes Elanth Media» (gestión de redes), sin precios ni condiciones de pago.
const ask = (pkg: string) =>
  whatsappLink(`Hola, me interesa el plan ${pkg} de Elanth Media. Me gustaría recibir una propuesta para mi negocio.`);

const days = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];

const plans = [
  {
    id: 'senal',
    name: 'Señal',
    icon: 'signal',
    pitch: 'Para arrancar en redes con una presencia ordenada y constante.',
    postDays: [1, 3],
    storiesPerDay: 1,
    reels: 1,
    items: [
      { icon: 'layers', strong: '2 posts o carruseles', rest: 'por semana' },
      { icon: 'film', strong: '1 reel', rest: 'al mes' },
      { icon: 'camera', strong: '1 story', rest: 'diaria' },
      { icon: 'chat', strong: 'Respuesta a DM', rest: 'con redirección a WhatsApp' },
    ],
  },
  {
    id: 'pulso',
    name: 'Pulso',
    icon: 'chart',
    badge: 'Recomendado',
    pitch: 'Para más movimiento: más reels y atención a tus comentarios.',
    postDays: [0, 2, 4],
    storiesPerDay: 2,
    reels: 3,
    items: [
      { icon: 'layers', strong: '3 posts o carruseles', rest: 'por semana' },
      { icon: 'film', strong: '3 reels', rest: 'al mes' },
      { icon: 'camera', strong: '2 stories', rest: 'diarias' },
      { icon: 'chat', strong: 'Respuesta a comentarios y DM', rest: 'con redirección a WhatsApp' },
    ],
  },
] as const;

const shared = [
  { icon: 'pen', text: 'Creación o rediseño de perfil' },
  { icon: 'calendar', text: 'Planificación de contenido' },
  { icon: 'target', text: '1 pauta publicitaria' },
  { icon: 'chat', text: 'Copy en cada publicación' },
  { icon: 'chart', text: 'Resumen estadístico' },
] as const;

const paths = [
  { icon: 'signal', audience: 'Señal', title: 'Arrancas en redes', body: 'Quieres una presencia ordenada y constante.', link: 'Ver el plan Señal', href: '#senal' },
  { icon: 'chart', audience: 'Pulso', title: 'Quieres más movimiento', body: 'Más reels y atención a tus comentarios.', link: 'Ver el plan Pulso', href: '#pulso' },
];

const steps = [
  { title: 'Cuéntanos qué vendes', body: 'Una conversación corta para entender tu negocio, tus clientes y tu meta.' },
  { title: 'Elige tu plan', body: 'Te ayudamos a escoger el que se ajuste a tu presupuesto y a tu ritmo.' },
  { title: 'Publicamos y te reportamos', body: 'Tu contenido sale a tiempo y recibes un resumen de resultados.' },
];

const pageUrl = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const schema = [
  {
    '@type': 'Service',
    name: 'Elanth Media',
    serviceType: 'Gestión de redes sociales',
    url: pageUrl,
    provider: { '@id': new URL(asset(''), Astro.site).href + '#organizacion' },
    description:
      'Campañas de marketing funcionales según tu nicho: gestión de redes sociales con posts, reels, stories, pauta publicitaria y atención de mensajes.',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Planes de Elanth Media',
      itemListElement: plans.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: `Plan ${p.name}` } })),
    },
  },
];
---
<Base
  title="Elanth Media | Gestión de redes sociales para tu negocio"
  description="Convertimos tu visión en campañas de marketing funcionales según tu nicho: planes de gestión de redes con posts, reels, stories y pauta publicitaria. Recibe una propuesta sin compromiso."
  schema={schema}
  ogImage="brand/og-elanth-media.png"
  ogImageAlt="Elanth Media: tu visión. Mil formas de contarla."
>
  <Nav />
  <main id="contenido">
    <!-- Hero -->
    <section class="aurora pt-28 pb-20 sm:pt-36 lg:pb-28">
      <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-4 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:px-12">
        <div class="lg:col-span-7">
          <h1 class="display text-[clamp(2.6rem,8vw,5.5rem)] text-paper">
            <span class="sr-only">Elanth Media: </span>
            Tu visión. <span class="text-coral">Mil formas de contarla.</span>
          </h1>
          <p class="mt-8 max-w-[36rem] text-lg leading-relaxed text-fog sm:text-xl">
            Convertimos tu visión en campañas de marketing funcionales, pensadas según tu nicho y lo que tu negocio necesita hoy.
          </p>
          <p class="mt-4 max-w-[36rem] text-lg font-semibold text-paper sm:text-xl">
            Nuestra meta: que los likes se conviertan en transacciones.
          </p>

          <div class="mt-10 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-7">
            <a href={whatsappLink(mediaWhatsappMessage)} target="_blank" rel="noopener" class="btn-lit w-full text-base sm:w-auto sm:text-lg">
              Recibe una propuesta
              <Icon name="arrow" class="size-5" />
            </a>
            <a href="#planes" class="link-quiet text-paper">Ver planes</a>
          </div>

          <div class="lockup mt-12">
            <img src={asset('brand/elanth-media-mark-light.svg')} alt="" width="1940" height="1110" />
            <span>
              <span class="block text-lg leading-none font-[820] tracking-[0.02em] text-paper [font-stretch:118%]">ELANTH MEDIA</span>
              <span class="mt-1.5 block text-sm text-fog">Redes sociales</span>
            </span>
          </div>
        </div>

        <div class="lg:col-span-5">
          <MediaFeed />
        </div>
      </div>
    </section>

    <!-- Gestión de redes -->
    <section id="planes" class="mesh-soft text-ink">
      <div class="mx-auto max-w-[90rem] px-4 py-24 sm:px-8 sm:py-32 lg:px-12">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-navy lg:col-span-7">
            Gestión de redes, <span class="text-coral-ink">a tu ritmo.</span>
          </h2>
          <p class="max-w-[34rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-2">
            Planes mensuales para que tu marca publique con constancia y cada conversación termine en WhatsApp. Así se ve
            una semana con cada plan:
          </p>
        </div>

        <div class="mt-14 grid gap-5 lg:mt-16 lg:grid-cols-2">
          {plans.map((p) => {
            const featured = 'badge' in p;
            return (
              <article id={p.id} class:list={['plan', featured ? 'plan-dark aurora' : 'card-soft']}>
                <span class="watermark plan-mark" aria-hidden="true">{p.name}</span>
                <header class="flex items-start justify-between gap-3">
                  <span class="flex items-center gap-4">
                    <span class:list={['hex', { 'hex-coral': featured }]}><Icon name={p.icon} class="size-5" /></span>
                    <span>
                      <span class:list={['tag-label block', { 'text-sky!': featured }]}>Plan mensual</span>
                      <span class:list={['mt-1 block text-[2.25rem] leading-none font-[820] tracking-[-0.02em] [font-stretch:118%]', featured ? 'text-paper' : 'text-navy']}>{p.name}</span>
                    </span>
                  </span>
                  {featured && <span class="badge">{p.badge}</span>}
                </header>
                <p class:list={['mt-5 max-w-[30rem] text-[1.0625rem] leading-relaxed', featured ? 'text-fog' : 'text-ink/80']}>{p.pitch}</p>

                <!-- Tu semana en redes -->
                <div class="week mt-6" aria-label={`Semana tipo del plan ${p.name}`}>
                  <div class="grid grid-cols-7 gap-1.5">
                    {days.map((d, i) => (
                      <div class="day">
                        <span class="day-name">{d}</span>
                        <span class:list={['post', { on: (p.postDays as readonly number[]).includes(i) }]} aria-hidden="true"></span>
                        <span class="flex justify-center gap-1" aria-hidden="true">
                          {Array.from({ length: p.storiesPerDay }, () => <span class="story"></span>)}
                        </span>
                      </div>
                    ))}
                  </div>
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-[0.8125rem]">
                    <span class="flex items-center gap-4">
                      <span class="flex items-center gap-1.5"><span class="post on legend" aria-hidden="true"></span>Post o carrusel</span>
                      <span class="flex items-center gap-1.5"><span class="story" aria-hidden="true"></span>Story</span>
                    </span>
                    <span class="flex items-center gap-1.5 font-semibold">
                      {Array.from({ length: p.reels }, () => <Icon name="film" class="reel size-4" />)}
                      <span class="ml-1">{p.reels} {p.reels === 1 ? 'reel' : 'reels'} al mes</span>
                    </span>
                  </div>
                </div>

                <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
                  {p.items.map((it) => (
                    <li class="feat">
                      <span class="feat-icon"><Icon name={it.icon} class="size-4" /></span>
                      <span class="text-[0.9375rem] leading-snug"><strong class="font-bold">{it.strong}</strong> {it.rest}</span>
                    </li>
                  ))}
                </ul>

                <a href={ask(p.name)} target="_blank" rel="noopener" class:list={['plan-cta mt-7', { 'plan-cta-lit': featured }]}>
                  Quiero el plan {p.name}
                  <Icon name="arrow" class="size-4" />
                </a>
              </article>
            );
          })}
        </div>

        <div class="card-soft mt-5 p-6 sm:p-7">
          <p class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="text-[1.125rem] font-[800] text-navy [font-stretch:110%]">Incluido en los dos planes</span>
            <span class="tag-label">Señal y Pulso</span>
          </p>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            {shared.map((s) => (
              <li class="flex items-center gap-3">
                <span class="hex hex-sm"><Icon name={s.icon} class="size-4" /></span>
                <span class="text-[0.9375rem] leading-snug text-ink">{s.text}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-dashed border-ink/15 pt-4 text-sm leading-relaxed text-muted">
            La pauta incluye la configuración y optimización de tu anuncio. La inversión publicitaria (presupuesto de anuncios)
            la pagas directamente a la plataforma.
          </p>
        </div>
      </div>
    </section>

    <!-- ¿Cuál me conviene? -->
    <Solutions
      id="cual-me-conviene"
      title="¿Cuál me conviene?"
      intro="Elige según el momento de tu negocio. Si dudas, te ayudamos a decidir en la primera conversación."
      items={paths}
      help={{ text: '¿Necesitas algo distinto?', link: 'Servicios fuera de estos planes se cotizan a medida', href: '#empezamos' }}
    />

    <!-- Así empezamos + propuesta -->
    <section id="empezamos" class="aurora">
      <div class="mx-auto grid max-w-[90rem] gap-14 px-4 py-24 sm:px-8 sm:py-32 lg:grid-cols-12 lg:gap-10 lg:px-12">
        <div class="lg:col-span-6">
          <h2 class="display text-[clamp(2.1rem,5.6vw,4rem)] text-paper">Así empezamos</h2>
          <ol class="mt-10 grid gap-4">
            {steps.map((s, i) => (
              <li class="step-row">
                <RingNum value={i + 1} progress={(i + 1) / steps.length} size={46} dark />
                <span>
                  <span class="tag-label block text-sky!">Paso {i + 1}</span>
                  <span class="mt-1 block text-lg font-semibold text-paper [font-stretch:104%]">{s.title}</span>
                  <span class="mt-1 block text-fog">{s.body}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div class="lg:col-span-6">
          <div class="proposal">
            <img src={asset('brand/elanth-media-mark-light.svg')} alt="" width="1940" height="1110" class="w-24" />
            <h2 class="mt-6 text-[clamp(1.75rem,3.6vw,2.5rem)] leading-[1.02] font-[820] tracking-[-0.02em] text-paper [font-stretch:118%]">
              Tu visión. <span class="text-coral">Mil formas de contarla.</span>
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-fog">Recibe una propuesta según tu negocio. Sin compromiso.</p>
            <a href={whatsappLink(mediaWhatsappMessage)} target="_blank" rel="noopener" class="btn-lit mt-8 w-full text-base sm:text-lg">
              Escríbenos por WhatsApp
              <Icon name="arrow" class="size-5" />
            </a>
            <p class="mt-5 text-sm text-fog">Servicios fuera de estos planes se cotizan a medida.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsApp message={mediaWhatsappMessage} />
</Base>

<style>
  .lockup { display: flex; align-items: center; gap: 1rem; }
  .lockup img { width: 4.5rem; height: auto; }
  .text-coral-ink { color: #d64545; }

  /* Planes */
  .plan > :not(.plan-mark) { position: relative; z-index: 1; }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    border-radius: 18px;
  }
  .plan-dark {
    border: 1px solid rgb(255 107 107 / 0.45);
    box-shadow: 0 30px 60px -30px rgb(11 31 51 / 0.8);
    color: var(--color-paper);
  }
  .plan-mark {
    z-index: 0;
    top: auto;
    bottom: -0.75rem;
    right: -0.5rem;
    font-size: 7.5rem;
  }
  .plan-dark .plan-mark { color: rgb(255 255 255 / 0.04); }
  .hex-coral { background: var(--color-coral); color: var(--color-navy); }
  .hex-sm { width: 2.25rem; height: 2.5rem; }
  .badge {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-navy);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .week {
    position: relative;
    padding: 1rem;
    border-radius: 14px;
    background: var(--color-ice);
    color: var(--color-muted);
  }
  .plan-dark .week { background: rgb(7 20 31 / 0.55); color: var(--color-fog); }
  .day { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .day-name { font-family: var(--font-mono); font-stretch: 82%; font-size: 0.6875rem; font-weight: 600; }
  .post {
    display: block;
    width: 100%;
    max-width: 2.75rem;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    border: 1.5px dashed rgb(11 31 51 / 0.15);
  }
  .post.on {
    border: 0;
    background: linear-gradient(150deg, var(--color-blue) 0%, var(--color-navy) 100%);
    box-shadow: 0 8px 14px -8px rgb(11 31 51 / 0.6);
  }
  .plan-dark .post { border-color: rgb(159 179 198 / 0.2); }
  .plan-dark .post.on { background: linear-gradient(150deg, var(--color-coral) 0%, #c2410c 100%); }
  .post.legend { width: 0.75rem; aspect-ratio: 4 / 5; border-radius: 2px; }
  .story { display: block; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-coral); }
  .plan-dark .story { background: var(--color-sky); }
  :global(.reel) { color: var(--color-blue-ink); }
  .plan-dark :global(.reel) { color: var(--color-coral); }

  .feat {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 12px;
    background: rgb(232 241 246 / 0.6);
    color: var(--color-ink);
  }
  .plan-dark .feat { background: rgb(255 255 255 / 0.05); color: var(--color-paper); }
  .feat-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    background: var(--color-navy);
    color: var(--color-sky);
  }
  .plan-dark .feat-icon { background: rgb(255 107 107 / 0.16); color: var(--color-coral); }

  .plan-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    margin-top: auto;
    border-radius: 8px;
    position: relative;
    z-index: 1;
    border: 1.5px solid var(--color-navy);
    background: #fff;
    font-weight: 700;
    color: var(--color-navy);
    transition: background-color 200ms, color 200ms;
  }
  .plan ul + .plan-cta { margin-top: 1.75rem; }
  .plan-cta:hover { background: var(--color-navy); color: var(--color-paper); }
  .plan-cta-lit { border-color: var(--color-coral); background: var(--color-coral); color: var(--color-navy); }
  .plan-cta-lit:hover { background: #ff8585; color: var(--color-navy); }

  .step-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 14px;
    border: 1px solid rgb(107 187 224 / 0.16);
    background: rgb(7 20 31 / 0.35);
  }
  .proposal {
    padding: 2rem 1.5rem;
    border-radius: 18px;
    border: 1px solid rgb(107 187 224 / 0.22);
    background: rgb(15 40 64 / 0.75);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
    backdrop-filter: blur(8px);
  }
  @media (min-width: 640px) {
    .plan { padding: 2.25rem 2rem; }
    .proposal { padding: 2.5rem; }
  }
</style>
