---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Ledger from '../components/Ledger.astro';
import Vision from '../components/Vision.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Elanth · Tu empresa vendiendo en línea, llave en mano"
  description="Creamos tu tienda online, la conectamos con tu ERP y vendemos en Mercado Libre, Amazon, eBay y Facebook Marketplace desde un solo inventario. Nuestro equipo la opera por ti. Pide tu asesoría y demo gratuita."
>
  <Nav />
  <main id="contenido">
    <Hero />
    <Services />
    <Ledger />
    <Vision />
    <Contact />
  </main>
  <Footer />
</Base>
