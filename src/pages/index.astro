---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Ledger from '../components/Ledger.astro';
import Solutions from '../components/Solutions.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Elanth · Tu negocio vendiendo en línea"
  description="Creamos tu tienda online a la medida de tu negocio: desde tu primera venta digital hasta la integración de tus sistemas y canales de venta, operaciones 100% delegadas y automatización con IA. Pide tu asesoría y demo gratuita."
>
  <Nav />
  <main id="contenido">
    <Hero />
    <Services />
    <Ledger />
    <Solutions />
    <Contact />
  </main>
  <Footer />
  <WhatsApp />
</Base>
