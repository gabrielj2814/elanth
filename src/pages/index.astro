---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Ledger from '../components/Ledger.astro';
import Solutions from '../components/Solutions.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Elanth | Tiendas online y e-commerce para tu negocio"
  description="Tiendas online a la medida: desde tu primera venta digital hasta integrar tus sistemas, operación delegada y automatización con IA. Asesoría gratis."
>
  <Nav />
  <main id="contenido">
    <Hero />
    <Services />
    <Ledger />
    <Solutions />
    <Contact />
  </main>
  <Footer />
  <WhatsApp />
</Base>
