---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { asset } from '../config';
---
<Base title="Página no encontrada | Elanth" description="La página que buscas no existe o cambió de dirección." noindex>
  <Nav />
  <main id="contenido" class="circuit-grid-dark bg-navy">
    <section class="mx-auto flex min-h-[80dvh] max-w-[90rem] flex-col justify-center px-4 pt-28 pb-20 sm:px-8 lg:px-12">
      <p class="font-mono text-sm text-sky [font-stretch:82%]">Error 404</p>
      <h1 class="display mt-4 max-w-[46rem] text-[clamp(2.4rem,7vw,5rem)] text-paper">
        Este pedido no <span class="text-sky">llegó a destino.</span>
      </h1>
      <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-fog">
        La página que buscas no existe o cambió de dirección. Vuelve al inicio o pide tu asesoría gratuita.
      </p>
      <div class="mt-10 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-7">
        <a href={asset('')} class="btn-lit w-full text-base sm:w-auto sm:text-lg">
          Volver al inicio
          <Icon name="arrow" class="size-5" />
        </a>
        <a href={asset('#asesoria')} class="link-quiet text-paper">Pedir asesoría gratuita</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
