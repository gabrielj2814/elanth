# URL pública final del sitio, sin barra al final (canónicas, sitemap, redes sociales).
SITE_URL=https://elanth.com

# Ruta base: "/" cuando el sitio vive en la raíz del dominio.
BASE_PATH=/

# Endpoint que recibe el formulario de "Obtener asesoría y demo gratuita".
# Compatible con Formspree (https://formspree.io) u otro servicio que acepte POST con FormData
# y responda JSON. Ejemplo: https://formspree.io/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=
